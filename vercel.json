{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "newlandit-ui": {
      "root": "front-end/newlandit-ui",
      "framework": "nuxtjs"
    },
    "back-end": {
      "root": "back-end",
      "framework": "sanity"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "newlandit-ui"
      }
    }
  ]
}
