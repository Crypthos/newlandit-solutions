{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "newlandit-ui": {
      "root": "front-end/newlandit-ui",
      "framework": "nuxtjs"
    },
    "back-end": {
      "root": "back-end",
      "framework": "sanity",
      "routes": [
        {
          "src": "/studio",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/"
            }
          ]
        },
        {
          "src": "/studio/(.*)",
          "transforms": [
            {
              "type": "request.path",
              "op": "set",
              "args": "/$1"
            }
          ]
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/studio",
      "destination": {
        "service": "back-end"
      }
    },
    {
      "source": "/studio/(.*)",
      "destination": {
        "service": "back-end"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "newlandit-ui"
      }
    }
  ]
}
